---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, localePrefix, type Lang } from '../i18n/ui';
import SocialLinks from './SocialLinks.astro';

import growFood from '../assets/growfood-logo.png';
import priemLogo from '../assets/priem-case-logo.png';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const assets: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(imageModules)) {
  const name = path.split('/').pop();
  if (name) assets[name] = mod.default;
}

interface Props {
  entry: CollectionEntry<'cases'>;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const base = localePrefix(lang);

const logos: Record<string, ImageMetadata> = {
  'grow-food': growFood,
  priem: priemLogo,
};
const logo = logos[entry.id];
const { title, client, external, social, sections, results, media } = entry.data;

// Конвертирует любую YouTube-ссылку (watch, shorts, youtu.be) в embed URL.
function embedUrl(url: string): string {
  const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([^&?/\s]+)/);
  return m ? `https://www.youtube.com/embed/${m[1]}` : url;
}

// Класс сетки для N видео: 1 = полная ширина, 2 = 2 кол., 3+ = 3 кол.
function videoGridClass(n: number): string {
  if (n === 1) return '';
  if (n === 2) return 'grid grid-cols-2 gap-4';
  return 'grid grid-cols-3 gap-4';
}
---

<main class="mx-auto max-w-3xl px-6 py-12">
  <a href={`${base}/#works`} class="text-sm opacity-70 hover:underline">← {t('case.back')}</a>

  <header class="mt-8 pb-8">
    {logo && (
      <div class="mb-6 h-16 w-16 overflow-hidden">
        <Image src={logo} alt={client} class="h-full w-full object-cover" />
      </div>
    )}
    <p class="text-sm uppercase tracking-widest opacity-70">{client}</p>
    <h1 class="mt-2 text-4xl font-bold sm:text-5xl">{title}</h1>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      {external && (
        <a
          href={external}
          target="_blank"
          rel="noopener noreferrer"
          class="border-2 border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper"
        >
          {t('case.visit')} ↗
        </a>
      )}
      {social.length > 0 && <SocialLinks items={social} />}
    </div>
  </header>

  <div class="mt-8 space-y-14">
    {sections.map((s) => (
      <section>
        <h2 class="text-sm uppercase tracking-widest opacity-70">{s.heading}</h2>

        {/* Раскладка секции */}
        {s.layout === 'aside-right' && s.images.length > 0 ? (
          <div class="mt-3 grid items-start gap-8 sm:grid-cols-2">
            <p class="text-lg leading-relaxed">{s.body}</p>
            <div class="space-y-4">
              {s.images.map((f) => assets[f] && (
                <Image src={assets[f]} alt={`${client} — ${s.heading}`} class="w-full" />
              ))}
            </div>
          </div>
        ) : s.layout === 'aside-left' && s.images.length > 0 ? (
          <div class="mt-3 grid items-start gap-8 sm:grid-cols-2">
            <div class="space-y-4">
              {s.images.map((f) => assets[f] && (
                <Image src={assets[f]} alt={`${client} — ${s.heading}`} class="w-full" />
              ))}
            </div>
            <p class="text-lg leading-relaxed">{s.body}</p>
          </div>
        ) : (
          <>
            <p class="mt-3 text-lg leading-relaxed">{s.body}</p>
            {s.images.length > 0 && (
              <div class:list={['mt-6 grid gap-4', s.images.length > 1 && 'sm:grid-cols-2']}>
                {s.images.map((f) => assets[f] && (
                  <Image src={assets[f]} alt={`${client} — ${s.heading}`} class="w-full" />
                ))}
              </div>
            )}
          </>
        )}

        {/* Видео секции — после текста и картинок */}
        {s.videos.length > 0 && (
          <div class:list={['mt-6', videoGridClass(s.videos.length)]}>
            {s.videos.map((url) => (
              <div class="aspect-video w-full overflow-hidden border-2 border-ink">
                <iframe
                  src={embedUrl(url)}
                  title={`${title} — ${s.heading}`}
                  class="h-full w-full"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              </div>
            ))}
          </div>
        )}

        {/* Ссылка-кнопка (напр. themeal.menu) */}
        {s.link && (
          <a
            href={s.link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-block border-2 border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper"
          >
            {s.link.label} ↗
          </a>
        )}
      </section>
    ))}
  </div>

  {/* Медиа-слоты: embed если есть URL, плейсхолдер если нет */}
  {media.length > 0 && (
    <section class="mt-14">
      <div class="grid gap-4 sm:grid-cols-2">
        {media.map((item) => (
          item.video ? (
            <div class="aspect-video w-full overflow-hidden border-2 border-ink">
              <iframe
                src={embedUrl(item.video)}
                title={item.label}
                class="h-full w-full"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
          ) : (
            <div class="flex aspect-video items-center justify-center border-2 border-dashed border-ink/40 text-sm opacity-50">
              {item.label}
            </div>
          )
        ))}
      </div>
    </section>
  )}

  {results.length > 0 && (
    <section class="mt-14 border-2 border-ink p-6">
      <h2 class="mb-4 text-sm uppercase tracking-widest opacity-70">{t('case.results')}</h2>
      <ul class="space-y-2">
        {results.map((r) => (
          <li class="flex gap-3 text-lg">
            <span aria-hidden="true" class="font-bold">→</span>
            <span>{r}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</main>
