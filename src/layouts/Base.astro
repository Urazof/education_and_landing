---
// === Frontmatter (между --- ) — серверный код, выполняется при сборке, в браузер НЕ попадает ===
import '../styles/global.css';
import { alternateLinks, localeTag, useTranslations, type Lang } from '../i18n/ui';
// Два шрифта «над сгибом» preload'им. ?url отдаёт hashed-адрес файла из сборки — тот же,
// что подставляет @font-face из fontsource, поэтому браузер не качает файл дважды.
// Относительный путь (а не пакетный) нужен, т.к. exports пакета не открывают /files/*.woff2.
import interUrl from '../../node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import fraunces from '../../node_modules/@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';

// Props, которые принимает layout. interface + TypeScript = типобезопасность в шаблонах.
interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  ogType?: 'website' | 'article'; // тип для Open Graph: главная — website, кейсы — article
  ogImage?: string; // путь к соц-картинке (root-relative). По умолчанию /og.png (1200×630, public/og.png).
  noindex?: boolean; // служебные страницы (404) не должны попадать в индекс
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]; // структурированные данные (Person / CreativeWork)
}

// Деструктуризация Astro.props со значениями по умолчанию.
const {
  title,
  description = 'Maria Tkachenko — marketing leader and brand strategist.',
  lang = 'en',
  ogType = 'website',
  ogImage = '/og.png',
  jsonLd,
  noindex = false,
} = Astro.props;
const t = useTranslations(lang);

// site задан в astro.config.mjs → доступен как Astro.site. Из него строим абсолютные URL.
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
const alternates = alternateLinks(Astro.url.pathname); // языковые версии текущей страницы
const ogImageUrl = ogImage ? new URL(ogImage, site).href : undefined;
const siteName = 'Maria Tkachenko';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f6f3ee" />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Канонический URL — какой адрес страницы считать главным (защита от дублей) -->
    <link rel="canonical" href={canonical} />

    <!-- hreflang: связываем языковые версии, чтобы Google не считал en/ru дублями -->
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.lang} href={new URL(alt.path, site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', site)} />

    <!-- Open Graph (превью ссылки в соцсетях/мессенджерах) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeTag[lang]} />
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={title} />
        </>
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <!-- JSON-LD: set:html, чтобы Astro не экранировал кавычки внутри JSON -->
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- именованный слот: страницы смогут добавить свои теги в <head> -->
    <slot name="head" />
  </head>
  <body class="min-h-screen antialiased">
    <!-- Skip-link: первый фокусируемый элемент, виден только при фокусе с клавиатуры -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-base focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-paper"
    >
      {t('a11y.skip')}
    </a>
    <!-- безымянный слот: сюда подставится содержимое страницы -->
    <slot />
  </body>
</html>
