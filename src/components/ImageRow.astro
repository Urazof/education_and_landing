---
// Несколько картинок в ОДНОМ ряду. При 2+ изображениях: пропорциональная ширина
// (flex-grow = aspect_ratio), высота ограничена сверху значением `height` (cap):
// высокие ряды центрируются с воздухом, широкие — заполняют ширину. Без кропа.
// При 1 изображении: естественная ширина во всю ширину контейнера.
// На мобиле — стопкой во всю ширину.
// `height` = максимальная высота ряда (cap) на десктопе, px.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  src: ImageMetadata;
  alt: string;
}
interface Props {
  images: Item[];
  height?: number;
}
const { images, height = 300 } = Astro.props;
const isMulti = images.length >= 2;
---

{images.length > 0 && (
  <div
    class={`flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-center sm:gap-10`}
    style={`--cap:${height}px`}
  >
    {images.map((im) => {
      const ratio = (im.src.width / im.src.height).toFixed(4);
      return isMulti ? (
        <div class="img-item overflow-hidden rounded-[5px]" style={`--r:${ratio}`}>
          <Image src={im.src} alt={im.alt} class="w-full object-cover sm:h-full" />
        </div>
      ) : (
        <Image
          src={im.src}
          alt={im.alt}
          class="w-full rounded-[5px] object-cover"
        />
      );
    })}
  </div>
)}

<style>
  /* «Justified row» с ограничением высоты. Ширина ∝ реальному аспекту (flex-grow = --r),
     высота через aspect-ratio → у всех картинок ОДИНАКОВАЯ высота, бокс совпадает с
     пропорцией фото → без кропа. НО max-width = cap × аспект ограничивает высоту сверху
     значением --cap: высокие (портретные) ряды не заполняют всю ширину. justify-center
     группирует картинки в центре с умеренным зазором (sm:gap-10) — узкие вертикальные пары
     стоят рядом, воздух уходит по бокам (а не разбрасывается к краям). Широкие (ландшафт/
     квадрат) ряды почти заполняют ширину (cap не срабатывает) → стоят у краёв. Аспекты
     не меняются. Респонсив: на узких экранах flex сжимает. */
  @media (min-width: 640px) {
    .img-item {
      flex: var(--r) 1 0%;
      aspect-ratio: var(--r);
      max-width: calc(var(--cap) * var(--r));
      min-width: 0;
    }
  }
</style>
