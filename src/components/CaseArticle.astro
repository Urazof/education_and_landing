---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, localePrefix, type Lang } from '../i18n/ui';
import SocialLinks from './SocialLinks.astro';

import growFood from '../assets/growfood-logo.png';
import priemLogo from '../assets/priem-case-logo.png';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const assets: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(imageModules)) {
  const name = path.split('/').pop();
  if (name) assets[name] = mod.default;
}

interface Props {
  entry: CollectionEntry<'cases'>;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const base = localePrefix(lang);

const logos: Record<string, ImageMetadata> = {
  'grow-food': growFood,
  priem: priemLogo,
};
const logo = logos[entry.id];
const { title, client, external, social, sections, results, media } = entry.data;

// YouTube URL → embed URL (watch / shorts / youtu.be → embed)
function embedUrl(url: string): string {
  const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([^&?/\s]+)/);
  return m ? `https://www.youtube.com/embed/${m[1]}` : url;
}

// Сетка для N видео: 1=full, 2=2col, 3=3col (пропорции из Miro: 1fr 1fr 3fr для GF)
function videoCols(n: number): string {
  if (n === 1) return 'grid grid-cols-1';
  if (n === 2) return 'grid grid-cols-2 gap-4';
  return 'grid grid-cols-[1fr_1fr_3fr] gap-4';
}
---

<main class="mx-auto max-w-3xl px-6 py-12">
  <a href={`${base}/#works`} class="text-sm opacity-70 hover:underline">← {t('case.back')}</a>

  <!-- Шапка: лого + клиент + заголовок + ссылка + соцсети -->
  <header class="mt-8 pb-8">
    {logo && (
      <div class="mb-6 h-16 w-auto overflow-hidden">
        <Image src={logo} alt={client} class="h-full object-contain" />
      </div>
    )}
    <p class="text-sm uppercase tracking-widest opacity-70">{client}</p>
    <h1 class="mt-2 text-4xl font-bold sm:text-5xl">{title}</h1>
    <div class="mt-6 flex flex-wrap items-center gap-4">
      {external && (
        <a href={external} target="_blank" rel="noopener noreferrer"
          class="border-2 border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper">
          {t('case.visit')} ↗
        </a>
      )}
      {social.length > 0 && <SocialLinks items={social} />}
    </div>
  </header>

  <!-- Секции кейса -->
  <div class="mt-8 space-y-12">
    {sections.map((s) => {
      const hasHeading = Boolean(s.heading);
      const hasBody = Boolean(s.body);
      const hasImages = s.images.length > 0;
      const hasVideos = s.videos.length > 0;

      // Чистый медиа-блок без текста (heading="" body="") — напр. boxing+packaging GF
      if (!hasHeading && !hasBody) {
        return (
          <section>
            {/* video-image: видео(шире)|картинка(уже) — см. grow-food.md */}
            {s.layout === 'video-image' && hasVideos && hasImages && (
              <div class="grid grid-cols-[2fr_1fr] gap-4 items-start">
                {s.videos.map((url) => (
                  <div class="aspect-video w-full overflow-hidden">
                    <iframe src={embedUrl(url)} title={`${title} media`}
                      class="h-full w-full" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen />
                  </div>
                ))}
                {s.images.map((f) => assets[f] && (
                  <Image src={assets[f]} alt={`${client} media`} class="w-full" />
                ))}
              </div>
            )}
            {/* Если просто картинки или просто видео без текста */}
            {s.layout !== 'video-image' && (
              <>
                {hasImages && (
                  <div class:list={['grid gap-4', s.images.length > 1 && 'sm:grid-cols-2']}>
                    {s.images.map((f) => assets[f] && (
                      <Image src={assets[f]} alt={`${client} media`} class="w-full" />
                    ))}
                  </div>
                )}
                {hasVideos && (
                  <div class:list={['mt-4', videoCols(s.videos.length)]}>
                    {s.videos.map((url) => (
                      <div class="aspect-video overflow-hidden">
                        <iframe src={embedUrl(url)} title={`${title} media`}
                          class="h-full w-full" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen />
                      </div>
                    ))}
                  </div>
                )}
              </>
            )}
          </section>
        );
      }

      // aside-right: текст|картинка (заголовок инлайн в тексте)
      if (s.layout === 'aside-right' && hasImages) {
        return (
          <section>
            <div class="grid items-start gap-8 sm:grid-cols-2">
              <p class="text-lg leading-relaxed">
                {hasHeading && <strong>{s.heading} </strong>}{s.body}
              </p>
              <div class="space-y-4">
                {s.images.map((f) => assets[f] && (
                  <Image src={assets[f]} alt={`${client} — ${s.heading}`} class="w-full" />
                ))}
              </div>
            </div>
            {hasVideos && (
              <div class:list={['mt-6', videoCols(s.videos.length)]}>
                {s.videos.map((url) => (
                  <div class="aspect-video overflow-hidden">
                    <iframe src={embedUrl(url)} title={`${title} — ${s.heading}`}
                      class="h-full w-full" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen />
                  </div>
                ))}
              </div>
            )}
            {s.link && (
              <a href={s.link.url} target="_blank" rel="noopener noreferrer"
                class="mt-4 inline-block border-2 border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper">
                {s.link.label} ↗
              </a>
            )}
          </section>
        );
      }

      // aside-left: картинка|текст
      if (s.layout === 'aside-left' && hasImages) {
        return (
          <section>
            <div class="grid items-start gap-8 sm:grid-cols-2">
              <div class="space-y-4">
                {s.images.map((f) => assets[f] && (
                  <Image src={assets[f]} alt={`${client} — ${s.heading}`} class="w-full" />
                ))}
              </div>
              <p class="text-lg leading-relaxed">
                {hasHeading && <strong>{s.heading} </strong>}{s.body}
              </p>
            </div>
            {hasVideos && (
              <div class:list={['mt-6', videoCols(s.videos.length)]}>
                {s.videos.map((url) => (
                  <div class="aspect-video overflow-hidden">
                    <iframe src={embedUrl(url)} title={`${title} — ${s.heading}`}
                      class="h-full w-full" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen />
                  </div>
                ))}
              </div>
            )}
            {s.link && (
              <a href={s.link.url} target="_blank" rel="noopener noreferrer"
                class="mt-4 inline-block border-2 border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper">
                {s.link.label} ↗
              </a>
            )}
          </section>
        );
      }

      // Default: текст → изображения (если есть) → видео → ссылка
      return (
        <section>
          <p class="text-lg leading-relaxed">
            {hasHeading && <strong>{s.heading} </strong>}{s.body}
          </p>
          {hasImages && (
            <div class:list={['mt-6 grid gap-4', s.images.length > 1 && 'sm:grid-cols-2']}>
              {s.images.map((f) => assets[f] && (
                <Image src={assets[f]} alt={`${client} — ${s.heading}`} class="w-full" />
              ))}
            </div>
          )}
          {hasVideos && (
            <div class:list={['mt-6', videoCols(s.videos.length)]}>
              {s.videos.map((url) => (
                <div class="aspect-video overflow-hidden">
                  <iframe src={embedUrl(url)} title={`${title} — ${s.heading}`}
                    class="h-full w-full" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen />
                </div>
              ))}
            </div>
          )}
          {s.link && (
            <a href={s.link.url} target="_blank" rel="noopener noreferrer"
              class="mt-4 inline-block border-2 border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper">
              {s.link.label} ↗
            </a>
          )}
        </section>
      );
    })}
  </div>

  <!-- Метрики Results (отдельный блок) — после секций, перед media -->
  {results.length > 0 && (
    <section class="mt-12 border-2 border-ink p-6">
      <h2 class="mb-4 text-sm uppercase tracking-widest opacity-70">{t('case.results')}</h2>
      <ul class="space-y-2">
        {results.map((r) => (
          <li class="flex gap-3 text-lg">
            <span aria-hidden="true" class="font-bold">→</span>
            <span>{r}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Media-слоты (gold video и т.п.) — самый конец страницы -->
  {media.length > 0 && (
    <section class="mt-12">
      <div class="grid gap-4 sm:grid-cols-2">
        {media.map((item) => (
          item.video ? (
            <div class="aspect-video overflow-hidden">
              <iframe src={embedUrl(item.video)} title={item.label}
                class="h-full w-full" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen />
            </div>
          ) : (
            <div class="flex aspect-video items-center justify-center border-2 border-dashed border-ink/40 text-sm opacity-50">
              {item.label}
            </div>
          )
        ))}
      </div>
    </section>
  )}
</main>
