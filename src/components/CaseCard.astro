---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Карточка кейса в Works. Показываем реальное изображение кейса с тёмным градиентом снизу,
// поверх — клиент + заголовок. Единое оформление для всех карточек → одинаковое скругление/вид.
interface Props {
  href: string;
  title: string;
  client: string;
  image: ImageMetadata;
  alt: string;
}
const { href, title, client, image, alt } = Astro.props;
---

<a
  href={href}
  class="group relative block aspect-[4/3] overflow-hidden rounded-[5px] border border-ink/10"
>
  <Image
    src={image}
    alt={alt}
    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
  />
  <!-- Градиент снизу для читаемости подписи -->
  <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/30 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 p-5">
    <p class="text-xs font-medium uppercase tracking-wide text-paper/80">{client}</p>
    <h3 class="mt-1 text-xl font-bold text-paper sm:text-2xl">{title}</h3>
  </div>
</a>
