---
// Форма обратной связи (docs/FORM-PLAN.md). Работает БЕЗ клиентского JS: обычный POST на Worker (/api/contact), ответ — редирект
// обратно на эту же страницу с якорем: #contact-sent (форма заменяется сообщением) или #contact-error (сообщение над формой).
// Показ/скрытие делает CSS-псевдокласс :target, поэтому ни скриптов, ни отдельных страниц «Спасибо» не нужно. Поля и их порядок — по схеме референса docs/form.png, внешний вид — наши токены.
//
// Доступность: у каждого поля видимый <label> (не только placeholder), required + autocomplete, граница поля темнее --line
// (контраст рамки ≥ 3:1), видимый фокус. Honeypot — поле-ловушка для ботов: скрыто со страницы, людям недоступно.
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// value уходит на сервер и в тему письма — одинаков для всех языков; подпись берётся из словаря.
const topics = [
  { value: 'hiring', label: t('form.topic.hiring') },
  { value: 'product', label: t('form.topic.product') },
  { value: 'talk', label: t('form.topic.talk') },
  { value: 'other', label: t('form.topic.other') },
];

const label = 'mb-1 block text-sm font-medium text-ink';
const field =
  'block w-full rounded-base border border-muted bg-paper px-3.5 py-2 text-[15px] text-ink transition-colors hover:border-ink focus:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent';
---

<div class="mt-6 max-w-[600px] [&:has(#contact-sent:target)_form]:hidden">
  <!-- Успех: форма скрыта (правило на обёртке выше), вместо неё сообщение. tabindex="-1" — чтобы после перехода по якорю фокус
       оказался на сообщении и скринридер его прочитал. -->
  <div
    id="contact-sent"
    role="status"
    tabindex="-1"
    class="hidden rounded-base border border-muted bg-paper-2 p-6 outline-none target:block sm:p-8"
  >
    <p class="text-[clamp(1.75rem,3.5vw,2.5rem)] leading-tight text-ink [font-family:var(--font-display)]">
      {t('form.sent.title')}<span class="text-accent">.</span>
    </p>
    <p class="mt-3">{t('form.sent.text')}</p>
  </div>

  <!-- Ошибка: форма остаётся на месте (без JS введённые данные не сохраняются), над ней — сообщение. -->
  <div
    id="contact-error"
    role="alert"
    tabindex="-1"
    class="mb-8 hidden rounded-base border border-ink bg-paper-2 p-6 outline-none target:block"
  >
    <p class="font-medium text-ink">{t('form.error.title')}</p>
    <p class="mt-1">{t('form.error.text')}</p>
  </div>

<form method="post" action="/api/contact" class="grid gap-4 sm:grid-cols-2">
  <input type="hidden" name="lang" value={lang} />

  <div class="sm:col-span-2">
    <label for="cf-topic" class={label}>{t('form.topic')}</label>
    <div class="relative">
      <select id="cf-topic" name="topic" required class:list={[field, 'cursor-pointer appearance-none pr-10']}>
        {topics.map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        class="pointer-events-none absolute right-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-ink"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m5 7.5 5 5 5-5"></path>
      </svg>
    </div>
  </div>

  <div>
    <label for="cf-name" class={label}>{t('form.name')} <span aria-hidden="true">*</span></label>
    <input id="cf-name" name="name" type="text" required maxlength="100" autocomplete="name" class={field} />
  </div>

  <div>
    <label for="cf-email" class={label}>{t('form.email')} <span aria-hidden="true">*</span></label>
    <input
      id="cf-email"
      name="email"
      type="email"
      required
      maxlength="254"
      autocomplete="email"
      inputmode="email"
      class={field}
    />
  </div>

  <div class="sm:col-span-2">
    <label for="cf-org" class={label}>
      {t('form.organization')} <span class="font-normal text-muted">({t('form.optional')})</span>
    </label>
    <input id="cf-org" name="organization" type="text" maxlength="150" autocomplete="organization" class={field} />
  </div>

  <div class="sm:col-span-2">
    <label for="cf-message" class={label}>{t('form.message')} <span aria-hidden="true">*</span></label>
    <textarea id="cf-message" name="message" required rows="3" maxlength="4000" class:list={[field, 'resize-y']}
    ></textarea>
  </div>

  <!-- Honeypot: человек его не видит и не фокусирует, бот заполняет все поля подряд → сервер отбрасывает такую заявку. -->
  <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
    <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="sm:col-span-2">
    <button
      type="submit"
      class="rounded-base bg-accent px-7 py-2.5 text-sm font-medium text-paper transition-colors hover:bg-accent-ink"
    >
      {t('form.send')}
    </button>
  </div>
</form>
</div>
