---
// Страница 404 (Cloudflare Pages отдаёт dist/404.html для несуществующих адресов). Одна страница на два языка:
// английский заголовок + русская строка, чтобы не плодить отдельные /ru/404. Не индексируется.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ui } from '../i18n/ui';

const lang = 'en';
---

<Base title="404 — Maria Tkachenko" description={ui.en['notfound.text']} lang={lang} noindex>
  <Nav lang={lang} />
  <main id="main" class="container-page py-24 md:py-36">
    <p class="eyebrow">404</p>
    <h1 class="mt-5 text-[clamp(2.5rem,6vw,5rem)] leading-[1.02] tracking-[-0.02em] text-ink">
      {ui.en['notfound.title']}<span class="text-accent">.</span>
    </h1>
    <p class="mt-6 max-w-md text-pretty">{ui.en['notfound.text']}</p>
    <p class="mt-2 max-w-md text-pretty text-muted" lang="ru">{ui.ru['notfound.text']}</p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="/" class="rounded-base bg-accent px-5 py-3 text-sm font-medium text-paper transition-colors hover:bg-accent-ink">
        {ui.en['case.back']}
      </a>
      <a href="/ru/" lang="ru" class="rounded-base border border-muted px-5 py-3 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent">
        {ui.ru['case.back']}
      </a>
    </div>
  </main>
  <Footer lang={lang} />
</Base>
