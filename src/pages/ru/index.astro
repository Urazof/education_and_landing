---
// Главная (RU, "/ru/"). Идентична EN-странице, отличается только lang — тексты придут из ui.ts.
// Пути импортов на уровень глубже (../../), т.к. файл в подпапке ru/.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Works from '../../components/Works.astro';
import Publications from '../../components/Publications.astro';
import Recognition from '../../components/Recognition.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

const lang = 'ru';
---

<Base title="Мария Ткаченко — бренд-стратег и маркетинг-лидер" lang={lang}>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <About lang={lang} />
    <Works lang={lang} />
    <Publications lang={lang} />
    <Recognition lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
