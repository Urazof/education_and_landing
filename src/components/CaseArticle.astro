---
// CASE ARTICLE — полное тело страницы кейса (как свёрстано в Miro): картинки стоят внутри своих
// секций вперемешку с текстом. Получает запись коллекции `cases` и язык, рендерит:
// назад-ссылка → шапка (лого/клиент/заголовок) → ссылка+соцсети → секции (текст + картинки секции)
// → медиа-слоты «coming soon» → блок метрик Results.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, localePrefix, type Lang } from '../i18n/ui';
import SocialLinks from './SocialLinks.astro';

// Бренд-лого по id записи (имя .md-файла).
import growFood from '../assets/growfood-logo.png';
import priem from '../assets/priem-logo.png';

// Все картинки из src/assets — резолвим по имени файла (его указывают секции в .md).
// import.meta.glob с eager:true даёт { путь: { default: ImageMetadata } } на этапе сборки.
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const assets: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(imageModules)) {
  const name = path.split('/').pop();
  if (name) assets[name] = mod.default;
}

interface Props {
  entry: CollectionEntry<'cases'>;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const base = localePrefix(lang);

const logos: Record<string, ImageMetadata> = {
  'grow-food': growFood,
  priem: priem,
};
const logo = logos[entry.id];
const { title, client, external, social, sections, results, media } = entry.data;
---

<main class="mx-auto max-w-3xl px-6 py-12">
  <a href={`${base}/#works`} class="text-sm opacity-70 hover:underline">← {t('case.back')}</a>

  <!-- Шапка кейса: лого бренда + клиент + заголовок -->
  <header class="mt-8 border-b-2 border-ink pb-8">
    {
      logo && (
        <div class="mb-6 flex h-16 w-16 items-center justify-center overflow-hidden border-2 border-ink">
          <Image src={logo} alt={client} class="h-full w-full object-cover" />
        </div>
      )
    }
    <p class="text-sm uppercase tracking-widest opacity-70">{client}</p>
    <h1 class="mt-2 text-4xl font-bold sm:text-5xl">{title}</h1>

    <!-- Внешняя ссылка + соцсети -->
    <div class="mt-6 flex flex-wrap items-center gap-4">
      {
        external && (
          <a
            href={external}
            target="_blank"
            rel="noopener noreferrer"
            class="border-2 border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper"
          >
            {t('case.visit')} ↗
          </a>
        )
      }
      {social.length > 0 && <SocialLinks items={social} />}
    </div>
  </header>

  <!-- Секции кейса: текст + картинки секции (картинки на своих местах, как в Miro) -->
  <div class="mt-12 space-y-12">
    {
      sections.map((s) => (
        <section>
          <h2 class="text-sm uppercase tracking-widest opacity-70">{s.heading}</h2>
          <p class="mt-3 text-lg leading-relaxed">{s.body}</p>
          {s.images.length > 0 && (
            <div class:list={['mt-6 grid gap-4', s.images.length > 1 && 'sm:grid-cols-2']}>
              {s.images.map((file) =>
                assets[file] ? (
                  <Image
                    src={assets[file]}
                    alt={`${client} — ${s.heading}`}
                    class="w-full border-2 border-ink"
                  />
                ) : null,
              )}
            </div>
          )}
        </section>
      ))
    }
  </div>

  <!-- Медиа-слоты, которых ещё нет (скринкасты/ролики/фото) — плейсхолдеры, как рамки в Miro -->
  {
    media.length > 0 && (
      <section class="mt-12">
        <div class="grid gap-4 sm:grid-cols-2">
          {media.map((label) => (
            <div class="flex aspect-video items-center justify-center border-2 border-dashed border-ink/40 p-4 text-center text-sm opacity-50">
              {label}
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Метрики Results (структурный массив, отдельно от прозы секций) -->
  {
    results.length > 0 && (
      <section class="mt-12 border-2 border-ink p-6">
        <h2 class="mb-4 text-sm uppercase tracking-widest opacity-70">{t('case.results')}</h2>
        <ul class="space-y-2">
          {results.map((r) => (
            <li class="flex gap-3 text-lg">
              <span aria-hidden="true" class="font-bold">
                →
              </span>
              <span>{r}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</main>
