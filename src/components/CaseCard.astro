---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Карточка кейса: обложка 4:3 (hover — scale 1.03), под ней клиент (подпись) и заголовок кейса (Fraunces).
// Раньше подпись лежала поверх картинки на градиенте — теперь под ней, как в docs/DESIGN.md.
interface Props {
  href: string;
  title: string;
  client: string;
  image: ImageMetadata;
  alt: string;
}
const { href, title, client, image, alt } = Astro.props;
---

<a href={href} class="group block">
  <div class="aspect-[4/3] overflow-hidden rounded-base border border-line bg-paper">
    <Image
      src={image}
      alt={alt}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </div>
  <p class="mt-4 text-xs font-medium uppercase tracking-[0.18em] text-muted">{client}</p>
  <h3
    class="mt-1.5 text-[1.625rem] leading-tight text-ink transition-colors group-hover:text-accent"
  >
    {title}
  </h3>
</a>
