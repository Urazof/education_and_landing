---
// Publications: список-строки из коллекции `press` (src/content/press.json).
// Колонки: издание / заголовок (Fraunces) / тип / ↗. Hover: фон paper-2, стрелка сдвигается на 4px.
import { getCollection } from 'astro:content';
import { useTranslations, type Lang, type UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const items = (await getCollection('press')).sort((a, b) => a.data.order - b.data.order);
---

<section id="publications">
  <div class="container-page py-[72px] md:py-[120px]">
    <p class="eyebrow">{t('publications.eyebrow')}</p>
    <h2 class="mt-5 text-[clamp(2rem,4vw,3rem)] leading-[1.05] text-ink">{t('publications.h2')}</h2>

    <ul class="mt-12 border-t border-ink">
      {
        items.map(({ data }) => (
          <li class="border-b border-line">
            <a
              href={data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group grid grid-cols-[1fr_auto] items-baseline gap-x-6 gap-y-1 px-3 py-5 transition-colors hover:bg-paper-2 md:grid-cols-[160px_1fr_auto_auto] md:gap-x-8"
            >
              <span class="col-span-2 text-xs uppercase tracking-[0.18em] text-muted md:col-span-1">
                {data.outlet}
              </span>
              <span class="font-display text-xl text-ink md:text-2xl">{data.title}</span>
              <span class="hidden text-sm text-muted md:inline">{t(`press.${data.kind}` as UiKey)}</span>
              <span
                aria-hidden="true"
                class="justify-self-end text-ink transition-transform group-hover:translate-x-1"
              >
                ↗
              </span>
              <span class="col-span-2 text-sm text-muted md:hidden">{t(`press.${data.kind}` as UiKey)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
