---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, localePrefix, type Lang } from '../i18n/ui';
import SocialLinks from './SocialLinks.astro';
import VideoGroup from './VideoGroup.astro';

import growFood from '../assets/growfood-logo.png';
import priemLogo from '../assets/priem-case-logo.png';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const assets: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(imageModules)) {
  const name = path.split('/').pop();
  if (name) assets[name] = mod.default;
}

interface Props {
  entry: CollectionEntry<'cases'>;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const base = localePrefix(lang);

const logos: Record<string, ImageMetadata> = {
  'grow-food': growFood,
  priem: priemLogo,
};
const logo = logos[entry.id];
const { title, client, external, social, sections } = entry.data;
const media = entry.data.media;

// Шрифт-классы для текста секции — единый стиль во всех раскладках.
const proseText = 'text-lg leading-relaxed';
---

<main class="mx-auto max-w-5xl px-6 py-12">
  <a href={`${base}/#works`} class="text-sm opacity-70 hover:underline">← {t('case.back')}</a>

  <!-- Шапка: лого + клиент + заголовок + ссылка + соцсети -->
  <header class="mt-8 max-w-3xl pb-8">
    {logo && (
      <div class="mb-6 h-16 w-auto overflow-hidden">
        <Image src={logo} alt={client} class="h-full w-auto object-contain" />
      </div>
    )}
    <p class="text-sm uppercase tracking-widest opacity-70">{client}</p>
    <h1 class="mt-2 text-4xl font-bold sm:text-5xl">{title}</h1>
    <div class="mt-6 flex flex-wrap items-center gap-4">
      {external && (
        <a href={external} target="_blank" rel="noopener noreferrer"
          class="rounded-[5px] border border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper">
          {t('case.visit')} ↗
        </a>
      )}
      {social.length > 0 && <SocialLinks items={social} />}
    </div>
  </header>

  <!-- Секции кейса -->
  <div class="mt-4 space-y-16">
    {sections.map((s) => {
      const hasHeading = Boolean(s.heading);
      const hasBody = Boolean(s.body);
      const hasImages = s.images.length > 0;
      const hasVideos = s.videos.length > 0;

      // Чистый медиа-блок без текста (heading="" body="")
      if (!hasHeading && !hasBody) {
        // video-image: видео(шире) | картинка(уже)
        if (s.layout === 'video-image' && hasVideos && hasImages) {
          return (
            <section class="grid items-start gap-6 sm:grid-cols-[2fr_1fr]">
              <VideoGroup videos={s.videos} title={`${title} media`} />
              <div class="space-y-4">
                {s.images.map((f) => assets[f] && (
                  <Image src={assets[f]} alt={`${client} media`} class="w-full rounded-[5px]" />
                ))}
              </div>
            </section>
          );
        }
        return (
          <section class="space-y-4">
            {hasImages && (
              <div class:list={['grid gap-4', s.images.length > 1 && 'sm:grid-cols-2']}>
                {s.images.map((f) => assets[f] && (
                  <Image src={assets[f]} alt={`${client} media`} class="w-full rounded-[5px]" />
                ))}
              </div>
            )}
            {hasVideos && <VideoGroup videos={s.videos} title={`${title} media`} />}
          </section>
        );
      }

      // aside-right: текст | картинка
      if (s.layout === 'aside-right' && hasImages) {
        return (
          <section>
            <div class="grid items-start gap-8 sm:grid-cols-2">
              <p class={proseText}>
                {hasHeading && <strong>{s.heading} </strong>}{s.body}
              </p>
              <div class="space-y-4">
                {s.images.map((f) => assets[f] && (
                  <Image src={assets[f]} alt={`${client} — ${s.heading}`} class="w-full rounded-[5px]" />
                ))}
              </div>
            </div>
            {hasVideos && <div class="mt-6"><VideoGroup videos={s.videos} title={`${title} — ${s.heading}`} /></div>}
            {s.link && (
              <a href={s.link.url} target="_blank" rel="noopener noreferrer"
                class="mt-4 inline-block rounded-[5px] border border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper">
                {s.link.label} ↗
              </a>
            )}
          </section>
        );
      }

      // aside-left: картинка | текст
      if (s.layout === 'aside-left' && hasImages) {
        return (
          <section>
            <div class="grid items-start gap-8 sm:grid-cols-2">
              <div class="space-y-4">
                {s.images.map((f) => assets[f] && (
                  <Image src={assets[f]} alt={`${client} — ${s.heading}`} class="w-full rounded-[5px]" />
                ))}
              </div>
              <p class={proseText}>
                {hasHeading && <strong>{s.heading} </strong>}{s.body}
              </p>
            </div>
            {hasVideos && <div class="mt-6"><VideoGroup videos={s.videos} title={`${title} — ${s.heading}`} /></div>}
            {s.link && (
              <a href={s.link.url} target="_blank" rel="noopener noreferrer"
                class="mt-4 inline-block rounded-[5px] border border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper">
                {s.link.label} ↗
              </a>
            )}
          </section>
        );
      }

      // Default: текст (читаемая ширина) → изображения → видео → ссылка
      return (
        <section>
          <p class:list={[proseText, 'max-w-3xl']}>
            {hasHeading && <strong>{s.heading} </strong>}{s.body}
          </p>
          {hasImages && (
            <div class:list={['mt-6 grid gap-4', s.images.length > 1 && 'sm:grid-cols-2']}>
              {s.images.map((f) => assets[f] && (
                <Image src={assets[f]} alt={`${client} — ${s.heading}`} class="w-full rounded-[5px]" />
              ))}
            </div>
          )}
          {hasVideos && <div class="mt-6"><VideoGroup videos={s.videos} title={`${title} — ${s.heading}`} /></div>}
          {s.link && (
            <a href={s.link.url} target="_blank" rel="noopener noreferrer"
              class="mt-4 inline-block rounded-[5px] border border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper">
              {s.link.label} ↗
            </a>
          )}
        </section>
      );
    })}
  </div>

  <!-- Media-слоты (gold video и т.п.) — самый конец страницы -->
  {media.length > 0 && (
    <section class="mt-16">
      <div class="grid gap-4 sm:grid-cols-2">
        {media.map((item) => (
          item.video ? (
            <div class="aspect-video overflow-hidden rounded-[5px] bg-ink/5">
              <iframe src={`https://www.youtube.com/embed/${item.video.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([^&?/\s]+)/)?.[1] ?? ''}`} title={item.label}
                loading="lazy" class="h-full w-full" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen />
            </div>
          ) : (
            <div class="flex aspect-video items-center justify-center rounded-[5px] border border-dashed border-ink/40 text-sm opacity-50">
              {item.label}
            </div>
          )
        ))}
      </div>
    </section>
  )}
</main>
