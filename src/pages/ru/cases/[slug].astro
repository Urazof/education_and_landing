---
// Страница кейса (RU): /ru/cases/grow-food, /ru/cases/priem.
// Тот же файл кейса, что и для EN (src/content/cases/<slug>.md): getCases('ru') берёт из полей { en, ru } русский текст
// (если ru нет — английский с предупреждением при сборке).
import { getCases } from '../../../lib/localize';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { caseDescription, caseJsonLd, getNextCase } from '../../../lib/cases';
import CaseArticle from '../../../components/CaseArticle.astro';

export async function getStaticPaths() {
  const cases = await getCases('ru');
  return cases.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, next: getNextCase(cases, entry) }, // запись + следующий кейс для ссылки внизу
  }));
}

const lang = 'ru';
const { entry, next } = Astro.props;
// description — начало текста самого кейса (уникален у каждого, ≤155 символов); JSON-LD — CreativeWork.
const description = caseDescription(entry);
const jsonLd = caseJsonLd(entry, new URL(Astro.url.pathname, Astro.site!), Astro.site!, lang);
---

<Base
  title={`${entry.data.title} — ${entry.data.client} · Мария Ткаченко`}
  description={description}
  lang={lang}
  ogType="article"
  jsonLd={jsonLd}
>
  <Nav lang={lang} />
  <CaseArticle entry={entry} lang={lang} next={next} />
  <Footer lang={lang} />
</Base>
