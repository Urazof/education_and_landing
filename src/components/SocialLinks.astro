---
// Ряд квадратных кнопок-соцсетей (IG / TG / VK …) в шапке страницы кейса.
// Принимает массив ссылок — компонент не знает, какие именно соцсети.
interface Social {
  label: string; // короткая подпись: LI / WA / TG / IG / VK
  url: string;
}
interface Props {
  items: Social[];
}
const { items } = Astro.props;
---

<ul class="flex items-center gap-2">
  {
    items.map((s) => (
      <li>
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.label}
          class="flex h-9 w-9 items-center justify-center rounded-base border border-ink/30 text-xs font-semibold text-ink transition-colors hover:border-accent hover:text-accent"
        >
          {s.label}
        </a>
      </li>
    ))
  }
</ul>
