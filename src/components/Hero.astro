---
// Hero по docs/DESIGN.md: эйброу-имя, H1 с курсивным словом и акцентной точкой, роли, абзац, две кнопки,
// портрет 4:5 справа с подписью. Фон секции — интерактивная canvas-сеть (NetworkCanvas, Phase 3):
// canvas лежит под контентом, контент — pointer-events: none (клики проходят на canvas), кроме ссылок и портрета.
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '../i18n/ui';
import mariaPhoto from '../assets/maria-photo.jpg';
import NetworkCanvas from './NetworkCanvas.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden">
  <NetworkCanvas lang={lang} />
  <div
    class="pointer-events-none relative container-page grid items-center gap-10 pb-14 pt-[6.5rem] sm:pb-20 sm:pt-24 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-16 lg:pb-24"
  >
    <div>
      <p class="eyebrow !text-muted">{t('hero.eyebrow')}</p>
      <!-- Кириллица шире латиницы: для ru кегль H1 меньше, иначе заголовок уходит в 4 строки -->
      <h1
        class:list={[
          'mt-6 leading-[0.98] tracking-[-0.02em] text-ink',
          lang === 'ru'
            ? 'text-[clamp(2.5rem,6.25vw,5.75rem)]'
            : 'text-[clamp(3.25rem,8vw,7.75rem)]',
        ]}
      >
        {t('hero.h1.a')}<em class="font-light italic">{t('hero.h1.em')}</em>{t('hero.h1.b')}<span
          class="text-accent">.</span
        >
      </h1>
      <p class="mt-8 text-xs font-semibold uppercase tracking-[0.12em] text-ink">
        {t('hero.roles')}
      </p>
      <p class="mt-4 max-w-xl text-pretty">{t('hero.intro')}</p>
      <div class="pointer-events-auto mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
        <a
          href="#works"
          class="rounded-base bg-accent px-5 py-3 text-sm font-medium text-paper transition-colors hover:bg-accent-ink"
        >
          {t('hero.ctaWork')}
        </a>
        <a
          href="#contact"
          class="text-sm font-medium text-ink underline underline-offset-4 decoration-ink/60 transition-colors hover:text-accent hover:decoration-accent"
        >
          {t('hero.ctaContact')}
        </a>
      </div>
    </div>

    <!-- Портрет 4:5 (исходник 1024×1280). width/height задают кроп и размер файла; eager — это LCP. -->
    <div class="pointer-events-auto mx-auto w-full max-w-[300px] lg:mx-0">
      <Image
        src={mariaPhoto}
        alt={t('hero.photoAlt')}
        width={600}
        height={750}
        position="top"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/5] w-full rounded-base object-cover"
      />
    </div>
  </div>
</section>
