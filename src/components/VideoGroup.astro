---
// Рендер группы видео секции ОДНИМ рядом одинаковой высоты (как на доске Miro:
// боксы видео стоят в линию, общая высота, ширина зависит от ориентации).
// Вертикальные (9:16) — узкие, горизонтальные (16:9) — широкие, высота общая.
// На мобиле — стопкой во всю ширину.
interface Video {
  url: string;
  vertical: boolean;
}
interface Props {
  videos: Video[];
  title?: string;
  // высота ряда на десктопе (px). По умолчанию 300.
  height?: number;
}
const { videos, title = 'video', height = 300 } = Astro.props;
const isSingleHorizontal = videos.length === 1 && !videos[0].vertical;
const rowH = isSingleHorizontal ? Math.round(height * 1.3) : height;

function embedUrl(url: string): string {
  const yt = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([^&?/\s]+)/);
  if (yt) return `https://www.youtube.com/embed/${yt[1]}`;
  const vi = url.match(/vimeo\.com\/(\d+)/);
  if (vi) return `https://player.vimeo.com/video/${vi[1]}`;
  return url;
}

const allow =
  'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
---

{videos.length > 0 && (
  <div class="flex flex-col items-center gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center" style={`--row-h:${rowH}px`}>
    {videos.map((v) => (
      <div
        class:list={[
          'overflow-hidden rounded-[5px] bg-ink/5',
          v.vertical
            ? `aspect-[9/16] w-full max-w-[220px] sm:h-[var(--row-h)] sm:max-w-none ${videos.length === 2 ? 'sm:flex-1 sm:min-w-0' : 'sm:w-auto'}`
            : `aspect-video w-full sm:h-[var(--row-h)] ${videos.length === 2 ? 'sm:flex-1 sm:min-w-0' : 'sm:w-auto'}`,
        ]}
      >
        <iframe src={embedUrl(v.url)} title={title} loading="lazy" class="h-full w-full" allow={allow} allowfullscreen />
      </div>
    ))}
  </div>
)}
