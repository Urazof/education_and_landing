---
// Hero + About merged (по макету Miro 2026-05-31): всё в одном контейнере.
// Левая колонка: приветствие → интро → about.p1. Правая: фото.
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '../i18n/ui';
import mariaPhoto from '../assets/maria-photo.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="py-10 sm:py-14">
  <div class="grid items-start gap-8 sm:grid-cols-[1fr_auto]">
    <div>
      <h1 class="text-2xl font-bold sm:text-3xl">{t('hero.greeting')}</h1>
      <p class="mt-3 text-base leading-relaxed opacity-80">{t('hero.intro')}</p>
      <p class="mt-4 text-base leading-relaxed">{t('about.p1')}</p>
    </div>
    <div class="flex-shrink-0">
      <Image
        src={mariaPhoto}
        alt={t('hero.photoAlt')}
        class="w-36 sm:w-44 rounded-sm"
        loading="eager"
      />
    </div>
  </div>
</section>
