---
// About: слева эйброу + H2 (курсивное «Then»), справа текст. Без числовой плашки (docs/DESIGN.md).
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="border-t border-line">
  <div
    class="container-page grid gap-8 py-[72px] md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-16 md:py-[120px]"
  >
    <div>
      <p class="eyebrow">{t('about.eyebrow')}</p>
      <h2 class="mt-5 text-[clamp(2rem,4vw,3rem)] leading-[1.05] text-ink">
        {t('about.h2.a')}<em class="font-light italic">{t('about.h2.em')}</em>{t('about.h2.b')}
      </h2>
    </div>
    <div class="max-w-2xl space-y-5">
      <p>{t('about.p1')}</p>
      <p>{t('bridge')}</p>
    </div>
  </div>
</section>
