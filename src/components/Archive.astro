---
import { useTranslations, localePrefix, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = localePrefix(lang);
---

<section id="archive" class="border-t-1 border-ink py-16">
  <a
    href={`${base}/cases/wrc`}
    class="flex h-32 w-full items-center justify-center rounded-[5px] border border-ink/30 px-4 py-3 text-center text-lg font-bold transition-colors hover:bg-ink/[0.06]"
  >
    {t('archive.title')}
  </a>
</section>
