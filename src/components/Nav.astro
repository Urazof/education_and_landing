---
// Шапка: sticky + blur (docs/DESIGN.md). Слева имя (Fraunces), справа 4 якорных пункта и переключатель языка.
// Соцсети — в секции Contact. Якоря ведут на секции главной: ${base}/#id.
import { useTranslations, localePrefix, alternateLinks, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = localePrefix(lang);

// Переключатель языка: ведёт на ту же страницу в другом языке (en ↔ ru) по тем же правилам, что hreflang.
const other: Lang = lang === 'en' ? 'ru' : 'en';
// У страницы 404 нет языковой версии (/ru/404/ не существует) → ведём на главную другого языка.
const isNotFound = /^\/404\/?$/.test(Astro.url.pathname);
const otherPath = isNotFound
  ? `${localePrefix(other)}/`
  : (alternateLinks(Astro.url.pathname).find((a) => a.lang === other)?.path ?? `${localePrefix(other)}/`);

const navLinks = [
  { id: 'about', key: 'nav.about' },
  { id: 'works', key: 'nav.works' },
  { id: 'publications', key: 'nav.publications' },
  { id: 'contact', key: 'nav.contact' },
] as const;
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/[0.88] backdrop-blur-[10px]">
  <!--
    Порядок элементов задаётся классами order-*, а не порядком в разметке:
      телефон:  [имя .......... EN]   (первая строка)
                [ссылки меню на всю ширину]   (вторая строка)
      sm и шире: [имя ........ ссылки | EN]   (одна строка, ссылки и переключатель сгруппированы справа)
    Так переключатель не «падает» на отдельную строку, когда меню не помещается рядом.
  -->
  <nav class="container-page flex flex-wrap items-center gap-x-6 gap-y-2 py-4" aria-label="Main">
    <a href={`${base}/`} class="order-1 font-display text-xl text-ink">Maria Tkachenko</a>
    <a
      href={otherPath}
      hreflang={other}
      lang={other}
      aria-label={t('nav.switch')}
      class="order-2 ml-auto text-sm font-medium uppercase tracking-[0.12em] text-ink transition-colors hover:text-accent sm:order-3 sm:ml-0 sm:border-l sm:border-line sm:pl-6"
    >
      {other}
    </a>
    <ul class="order-3 flex w-full flex-wrap items-center gap-x-6 gap-y-1 text-sm sm:order-2 sm:ml-auto sm:w-auto">
      {
        navLinks.map((l) => (
          <li>
            <a href={`${base}/#${l.id}`} class="text-ink-2 transition-colors hover:text-accent">
              {t(l.key)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
