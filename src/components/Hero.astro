---
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '../i18n/ui';
import mariaPhoto from '../assets/maria-photo.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="py-10 sm:py-14">
  <!-- overflow-hidden clamps the photo to the banner's rounded corners on desktop -->
  <div class="overflow-hidden rounded-[5px] bg-ink/[0.08] sm:min-h-[260px]">
    <div class="grid items-stretch gap-4 p-4 sm:grid-cols-[minmax(0,1fr)_220px] sm:gap-0 sm:p-0">
      <!-- Text column -->
      <div class="flex flex-col justify-center sm:py-4 sm:pl-7 sm:pr-5">
        <h1 class="text-lg font-bold leading-tight sm:text-xl">{t('hero.greeting')}</h1>
        <p class="mt-3 text-sm leading-relaxed opacity-80">{t('hero.intro')}</p>
        <p class="mt-3 text-sm leading-relaxed">{t('about.p1')}</p>
        <p class="mt-6 text-sm font-bold text-ink/50">{t('bridge')}</p>
      </div>
      <!-- Photo column: centered on mobile, flush right/top/bottom on desktop -->
      <div class="flex justify-center sm:block sm:self-stretch">
        <Image
          src={mariaPhoto}
          alt={t('hero.photoAlt')}
          class="w-44 rounded-[5px] sm:h-full sm:w-full sm:rounded-none sm:object-cover sm:object-top"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
