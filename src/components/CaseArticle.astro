---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, localePrefix, type Lang } from '../i18n/ui';
import SocialLinks from './SocialLinks.astro';
import VideoGroup from './VideoGroup.astro';
import ImageRow from './ImageRow.astro';
import MediaRow from './MediaRow.astro';

import growFood from '../assets/growfood-logo.png';
import priemLogo from '../assets/priem-case-logo.png';
import wrcLogo from '../assets/wrc-logo.png';
import philipsLogo from '../assets/philips-logo.png';
import eucerincardLogo from '../assets/eucerin-logo.png';
import cofixLogo from '../assets/cofix-logo.png';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const assets: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(imageModules)) {
  const name = path.split('/').pop();
  if (name) assets[name] = mod.default;
}

interface Props {
  entry: CollectionEntry<'cases'>;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const base = localePrefix(lang);

const logos: Record<string, ImageMetadata> = {
  'grow-food': growFood,
  priem: priemLogo,
  wrc: wrcLogo,
  philips: philipsLogo,
  eucerin: eucerincardLogo,
  cofix: cofixLogo,
};
const logo = logos[entry.id];
const { title, client, external, social, sections } = entry.data;
const media = entry.data.media;

const proseText = 'text-lg leading-relaxed';
const ROW_H = 300; // общая высота рядов ВИДЕО на десктопе (px)
const IMG_ROW_CAP = 500; // макс. высота рядов картинок (cap): квадрат/ландшафт-пары заполняют
// ширину (≤cap), только высокие портретные пары упираются в cap и центрируются

function embedUrl(url: string): string {
  const yt = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([^&?/\s]+)/);
  if (yt) return `https://www.youtube.com/embed/${yt[1]}`;
  const vi = url.match(/vimeo\.com\/(\d+)/);
  if (vi) return `https://player.vimeo.com/video/${vi[1]}`;
  return url;
}
const allow =
  'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';

// Хелпер: имена файлов секции → массив {src, alt} для ImageRow.
function imgItems(files: string[], alt: string) {
  return files.filter((f) => assets[f]).map((f) => ({ src: assets[f], alt }));
}
---

<main class="mx-auto max-w-5xl px-6 py-12">
  <a href={`${base}/`} class="text-sm opacity-70 hover:underline">← {t('case.back')}</a>

  <!-- Шапка: лого слева, текст + ссылка + соцсети справа (как на доске) -->
  <header class="mt-8 flex flex-col gap-6 border-b border-ink/10 pb-10 sm:flex-row sm:items-start sm:gap-8">
    {logo && (
      <div class="w-[120px] shrink-0 overflow-hidden rounded-[5px] sm:w-[150px]">
        <Image src={logo} alt={client} class="h-auto w-full object-contain" />
      </div>
    )}
    <div>
      <p class="text-sm uppercase tracking-widest opacity-70">{client}</p>
      <h1 class="mt-2 text-4xl font-bold sm:text-5xl">{title}</h1>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        {external && (
          <a href={external} target="_blank" rel="noopener noreferrer"
            class="rounded-[5px] border border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper">
            {t('case.visit')} ↗
          </a>
        )}
        {social.length > 0 && <SocialLinks items={social} />}
      </div>
    </div>
  </header>

  <!-- Секции кейса -->
  <div class="mt-12 space-y-16">
    {sections.map((s) => {
      const hasHeading = Boolean(s.heading);
      const hasBody = Boolean(s.body);
      const hasImages = s.images.length > 0;
      const hasVideos = s.videos.length > 0;

      // Чистый медиа-блок без текста
      if (!hasHeading && !hasBody) {
        // media-row: видео + картинки в один ряд (сначала videos, потом images)
        if (s.layout === 'media-row' && (hasVideos || hasImages)) {
          return (
            <section>
              <MediaRow videos={s.videos} images={imgItems(s.images, `${client} media`)} height={IMG_ROW_CAP} title={`${title} media`} />
            </section>
          );
        }
        // video-image: видео (горизонт.) + картинка в один ряд общей высоты
        if (s.layout === 'video-image' && hasVideos && hasImages) {
          return (
            <section class="flex flex-col items-center gap-4 sm:flex-row sm:items-center sm:justify-center" style={`--row-h:${ROW_H}px`}>
              {s.videos.map((v) => (
                <div class="aspect-video w-full overflow-hidden rounded-[5px] bg-ink/5 sm:h-[var(--row-h)] sm:w-auto">
                  <iframe src={embedUrl(v.url)} title={`${title} media`} loading="lazy" class="h-full w-full" allow={allow} allowfullscreen />
                </div>
              ))}
              {s.images.map((f) => assets[f] && (
                <Image src={assets[f]} alt={`${client} media`} class="w-full rounded-[5px] object-cover sm:h-[var(--row-h)] sm:w-auto" />
              ))}
            </section>
          );
        }
        return (
          <section class="space-y-4">
            {hasImages && <ImageRow images={imgItems(s.images, `${client} media`)} height={IMG_ROW_CAP} />}
            {hasVideos && <VideoGroup videos={s.videos} title={`${title} media`} height={ROW_H} />}
          </section>
        );
      }

      // spotlight: выделенный callout с бейджем награды и опц. кнопкой-ссылкой
      if (s.layout === 'spotlight') {
        return (
          <section class="rounded-[5px] bg-ink/[0.04] p-6 sm:p-8">
            <div class="flex flex-wrap items-center gap-3">
              {hasHeading && <p class="text-sm uppercase tracking-widest opacity-70">{s.heading}</p>}
              {s.award && (
                <span class="rounded-full border border-ink/20 px-3 py-1 text-xs font-semibold">
                  🥉 {s.award}
                </span>
              )}
            </div>
            {hasBody && <p class={`mt-3 ${proseText}`}>{s.body}</p>}
            {s.link && (
              <a href={s.link.url} target="_blank" rel="noopener noreferrer"
                class="mt-4 inline-block rounded-[5px] border border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper">
                {s.link.label} ↗
              </a>
            )}
          </section>
        );
      }

      // aside-right: текст | картинка (или видео, если картинки нет — напр. Cofix Context)
      if (s.layout === 'aside-right' && (hasImages || hasVideos)) {
        const asideVideo = !hasImages && hasVideos;
        // Узкий портрет-видео стоит на макете уже картинки: колонка 1fr (≈0.32× текста,
        // как на доске 238 vs 750), у картинок — 2fr.
        const asideCols = asideVideo ? 'sm:grid-cols-[3fr_1fr]' : 'sm:grid-cols-[3fr_2fr]';
        return (
          <section>
            <div class:list={['grid items-center gap-8', asideCols]}>
              <div class="space-y-6">
                <p class={proseText}>
                  {hasHeading && <strong>{s.heading} </strong>}{s.body}
                </p>
                {s.extra.map((e) => (
                  <p class={proseText}><strong>{e.heading} </strong>{e.body}</p>
                ))}
              </div>
              <div class="space-y-4">
                {hasImages && s.images.map((f) => assets[f] && (
                  <Image src={assets[f]} alt={`${client} — ${s.heading}`} class="w-full rounded-[5px]" />
                ))}
                {asideVideo && s.videos.map((v) => (
                  <div class={`overflow-hidden rounded-[5px] bg-ink/5 ${v.vertical ? 'aspect-[9/16]' : 'aspect-video'} w-full`}>
                    <iframe src={embedUrl(v.url)} title={`${title} — ${s.heading}`} loading="lazy" class="h-full w-full" allow={allow} allowfullscreen />
                  </div>
                ))}
              </div>
            </div>
            {hasImages && hasVideos && <div class="mt-6"><VideoGroup videos={s.videos} title={`${title} — ${s.heading}`} height={ROW_H} /></div>}
            {s.link && (
              <a href={s.link.url} target="_blank" rel="noopener noreferrer"
                class="mt-4 inline-block rounded-[5px] border border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper">
                {s.link.label} ↗
              </a>
            )}
          </section>
        );
      }

      // aside-left: картинка | текст
      if (s.layout === 'aside-left' && hasImages) {
        return (
          <section>
            <div class="grid items-center gap-8 sm:grid-cols-[2fr_3fr]">
              <div class="space-y-4">
                {s.images.map((f) => assets[f] && (
                  <Image src={assets[f]} alt={`${client} — ${s.heading}`} class="w-full rounded-[5px]" />
                ))}
              </div>
              <div class="space-y-6">
                <p class={proseText}>
                  {hasHeading && <strong>{s.heading} </strong>}{s.body}
                </p>
                {s.extra.map((e) => (
                  <p class={proseText}><strong>{e.heading} </strong>{e.body}</p>
                ))}
              </div>
            </div>
            {hasVideos && <div class="mt-6"><VideoGroup videos={s.videos} title={`${title} — ${s.heading}`} height={ROW_H} /></div>}
            {s.link && (
              <a href={s.link.url} target="_blank" rel="noopener noreferrer"
                class="mt-4 inline-block rounded-[5px] border border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper">
                {s.link.label} ↗
              </a>
            )}
          </section>
        );
      }

      // Default: текст → метрик-чипы → картинки (ряд) → видео (ряд) → ссылки → кнопка
      return (
        <section>
          <p class={proseText}>
            {hasHeading && <strong>{s.heading} </strong>}{s.body}
          </p>
          {s.metrics.length > 0 && (
            <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
              {s.metrics.map((m) => (
                <div class="rounded-[5px] border border-[#eeeeee] bg-[#ededed] px-5 py-6">
                  <p class="text-4xl font-bold text-ink">{m.value}</p>
                  <p class="mt-1 text-sm text-ink/60">{m.label}</p>
                </div>
              ))}
            </div>
          )}
          {s.after && <p class={`mt-6 ${proseText}`}>{s.after}</p>}
          {hasImages && <div class="mt-6"><ImageRow images={imgItems(s.images, `${client} — ${s.heading}`)} height={IMG_ROW_CAP} /></div>}
          {hasVideos && <div class="mt-6"><VideoGroup videos={s.videos} title={`${title} — ${s.heading}`} height={ROW_H} /></div>}
          {s.links.length > 0 && (
            <ul class="mt-4 space-y-1">
              {s.links.map((l) => (
                <li>
                  <a href={l.url} target="_blank" rel="noopener noreferrer"
                     class="break-all text-sm opacity-60 hover:opacity-100 hover:underline">
                    {l.label ?? l.url}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {s.link && (
            <a href={s.link.url} target="_blank" rel="noopener noreferrer"
              class="mt-4 inline-block rounded-[5px] border border-ink px-4 py-2 text-sm font-semibold transition-colors hover:bg-ink hover:text-paper">
              {s.link.label} ↗
            </a>
          )}
        </section>
      );
    })}
  </div>

  <!-- Media-слоты (gold video и т.п.) — конец страницы -->
  {media.length > 0 && (
    <section class="mt-16">
      <div class="flex flex-wrap justify-center gap-4">
        {media.map((item) => (
          item.video ? (
            <div class={`aspect-video w-full overflow-hidden rounded-[5px] bg-ink/5 ${media.length === 1 ? 'sm:h-[390px] sm:w-auto' : 'sm:w-[48%]'}`}>
              <iframe src={embedUrl(item.video)} title={item.label} loading="lazy" class="h-full w-full" allow={allow} allowfullscreen />
            </div>
          ) : (
            <div class={`flex aspect-video w-full items-center justify-center rounded-[5px] border border-dashed border-ink/40 text-sm opacity-50 ${media.length === 1 ? 'sm:w-[65%]' : 'sm:w-[48%]'}`}>
              {item.label}
            </div>
          )
        ))}
      </div>
    </section>
  )}
</main>
