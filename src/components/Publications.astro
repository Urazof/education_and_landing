---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Реальный контент из доски Miro (2026-05-31).
// Строка 1 (3 чипа), строка 2 (3 чипа), строка 3 (1 полноширинный).
const row1 = [
  'Budget Brand Positioning',
  'Brand transformation',
  'Expert Commentary',
];
const row2 = [
  'Industry Insight',
  'Marketing Conspiracies (Podcast)',
  'The Anatomy of Advertising (Podcast)',
];
const fullWidth = 'Jury Member, E+ Awards (formerly Effie), 2024';
---

<section id="publications" class="py-16">
  <h2 class="mb-6 text-2xl font-bold">{t('publications.title')}</h2>
  <div class="space-y-3">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      {row1.map((item) => (
        <div class="flex items-center justify-center border-2 border-ink px-4 py-3 text-center text-sm font-semibold">
          {item}
        </div>
      ))}
    </div>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      {row2.map((item) => (
        <div class="flex items-center justify-center border-2 border-ink px-4 py-3 text-center text-sm font-semibold">
          {item}
        </div>
      ))}
    </div>
    <div class="flex items-center justify-center border-2 border-ink px-4 py-3 text-center text-sm font-semibold">
      {fullWidth}
    </div>
  </div>
</section>
