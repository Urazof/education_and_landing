---
// Подвал: копирайт слева, мелкие служебные ссылки справа (docs/DESIGN.md, секция 8).

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="container-page flex flex-col gap-2 py-8 text-sm text-muted sm:flex-row sm:justify-between">
    <span>© {year} Maria Tkachenko. {t('footer.rights')}.</span>
    <span class="flex gap-5">
      <a href="/sitemap-index.xml" class="transition-colors hover:text-accent">{t('footer.sitemap')}</a>
      <a href="/llms.txt" class="transition-colors hover:text-accent">llms.txt</a>
    </span>
  </div>
</footer>
