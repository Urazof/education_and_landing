---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { useTranslations, localePrefix, type Lang } from '../i18n/ui';
import CaseCard from './CaseCard.astro';

// Фоновые изображения карточек Works — реальные кейс-медиа, а не логотипы.
import growFoodCardBg from '../assets/growfood-card-bg.png';
import priemCardBg from '../assets/priem-card-bg.png';
import eucerincardBg from '../assets/eucerin-card-bg.png';
import philipsCardBg from '../assets/philips-card-bg.png';
import worksPreview from '../assets/works-preview.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = localePrefix(lang);

const images: Record<string, ImageMetadata> = {
  'grow-food': growFoodCardBg,
  priem: priemCardBg,
  eucerin: eucerincardBg,
  philips: philipsCardBg,
};

const cases = (await getCollection('cases'))
  .filter((e) => !e.data.archive)
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="works" class="pb-16 pt-8">
  <h2 class="mb-8 text-xl font-bold">{t('works.title')}</h2>
  <div class="grid gap-6 sm:grid-cols-2">
    {
      cases.map((entry) => (
        <CaseCard
          href={`${base}/cases/${entry.id}`}
          title={entry.data.title}
          client={entry.data.client}
          image={images[entry.id] ?? worksPreview}
          alt={entry.data.client}
        />
      ))
    }
  </div>
</section>
