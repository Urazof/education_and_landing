---
import { getCases } from '../lib/localize';
import type { ImageMetadata } from 'astro';
import { useTranslations, localePrefix, type Lang } from '../i18n/ui';
import CaseCard from './CaseCard.astro';

// Фоновые изображения карточек Works — реальные кейс-медиа, а не логотипы.
import growFoodCardBg from '../assets/growfood-card-bg.png';
import priemCardBg from '../assets/priem-card-bg.jpg';
import eucerinCardBg from '../assets/eucerin-card-bg.png';
import philipsCardBg from '../assets/philips-card-bg.png';
import cofixCardBg from '../assets/cofix-card-bg.jpg';
import worksPreview from '../assets/works-preview.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = localePrefix(lang);

const images: Record<string, ImageMetadata> = {
  'grow-food': growFoodCardBg,
  priem: priemCardBg,
  eucerin: eucerinCardBg,
  philips: philipsCardBg,
  cofix: cofixCardBg,
};

// Названия карточек — в языке страницы (getCases разворачивает { en, ru }); порядок по `order` уже задан.
const cases = (await getCases(lang)).filter((e) => !e.data.archive);
---

<section id="works" class="bg-paper-2">
  <div class="container-page py-[72px] md:py-[120px]">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <div>
        <p class="eyebrow">{t('works.title')}</p>
        <h2 class="mt-5 max-w-md text-[clamp(2rem,4vw,3rem)] leading-[1.05] text-ink">
          {t('works.h2')}
        </h2>
      </div>
      <!-- Архив: был отдельной секцией-чипом, теперь ссылка справа от заголовка (макет). -->
      <a
        href={`${base}/cases/wrc/`}
        class="eyebrow !text-accent border-b border-accent/40 pb-1 transition-colors hover:border-accent"
      >
        {t('archive.title')} →
      </a>
    </div>

    <!-- Сетка: 1 колонка на телефоне, 2 на планшете, 6-колоночная на десктопе. Первые две карточки занимают
         по 3 колонки (2 крупные сверху), остальные по 2 (по 3 в ряд ниже) → 2 + 3 при пяти кейсах.
         Утилиты написаны целиком (не собираются из строк), иначе Tailwind их не найдёт. Если кейсов нечётное
         число, на планшете последняя карточка растягивается на обе колонки. -->
    <div class="mt-12 grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-6">
      {
        cases.map((entry, i) => (
          <div
            class:list={[
              'min-w-0',
              i < 2 ? 'lg:col-span-3' : 'lg:col-span-2',
              cases.length % 2 === 1 && i === cases.length - 1 && 'md:col-span-2 lg:col-span-2',
            ]}
          >
            <CaseCard
              href={`${base}/cases/${entry.id}/`}
              title={entry.data.title}
              client={entry.data.client}
              image={images[entry.id] ?? worksPreview}
              alt=""
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
