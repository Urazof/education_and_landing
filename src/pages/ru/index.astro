---
// Главная (RU, "/ru/"). Идентична EN-странице, отличается только lang — тексты придут из ui.ts.
// Пути импортов на уровень глубже (../../), т.к. файл в подпапке ru/.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Works from '../../components/Works.astro';
import Archive from '../../components/Archive.astro';
import Publications from '../../components/Publications.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

const lang = 'ru';
---

<Base title="Мария Ткаченко — Бренд-стратег" lang={lang}>
  <Nav lang={lang} />
  <main class="mx-auto max-w-5xl px-6">
    <Hero lang={lang} />
    <Works lang={lang} />
    <Archive lang={lang} />
    <Publications lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
