---
// ARCHIVE: на доске секция есть, но контент — пустой плейсхолдер. Верстаем структуру-заглушку,
// контент пользователь добавит позже (см. CONTEXT_LANDING.md §9).
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="archive" class="border-t-1 border-ink py-16">
  <h2 class="mb-6 text-xl font-bold">{t('archive.title')}</h2>
  <div class="flex h-32 items-center justify-center rounded-[5px] border border-dashed border-ink/40 text-sm opacity-50">
    {t('archive.note')}
  </div>
</section>
