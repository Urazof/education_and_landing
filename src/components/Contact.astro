---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-8">
  <a
    href="https://www.linkedin.com/in/maria-tkachenko-k/"
    target="_blank"
    rel="noopener noreferrer"
    class="text-lg font-semibold transition-colors hover:underline"
  >
    {t('contact.title')}
  </a>
</section>
