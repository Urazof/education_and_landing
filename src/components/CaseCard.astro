---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Карточка кейса в Works. Фоновое изображение с полупрозрачным белым оверлеем и текстом — 1:1 макет.
// Слабая связанность: карточка получает готовые поля, не зная про коллекцию.
interface Props {
  href: string;
  title: string;
  client: string;
  image: ImageMetadata;
  alt: string;
}
const { href, title, client, image, alt } = Astro.props;
---

<a href={href} class="group relative block aspect-square overflow-hidden rounded-[5px]">
  <Image
    src={image}
    alt={alt}
    class="absolute inset-0 h-full w-full object-cover"
  />
  <!-- белый оверлей 90% opacity, как fillOpacity: 0.9 в Miro. Hover → тёмный -->
  <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center
              bg-white/90 group-hover:bg-ink/90 transition-colors duration-200">
    <h3 class="text-2xl font-bold group-hover:text-paper">{title}</h3>
    <p class="mt-1 text-sm opacity-70 group-hover:opacity-80 group-hover:text-paper">{client}</p>
  </div>
</a>
