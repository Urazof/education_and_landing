---
// Страница кейса (EN): /cases/grow-food, /cases/priem.
// getStaticPaths генерирует по одному маршруту на каждый кейс; getCases('en') разворачивает поля { en, ru } в английский.
import { getCases } from '../../lib/localize';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { caseDescription, caseJsonLd, getNextCase } from '../../lib/cases';
import CaseArticle from '../../components/CaseArticle.astro';

export async function getStaticPaths() {
  const cases = await getCases('en');
  return cases.map((entry) => ({
    params: { slug: entry.id }, // slug = имя .md-файла (grow-food, priem)
    props: { entry, next: getNextCase(cases, entry) }, // запись + следующий кейс для ссылки внизу
  }));
}

const lang = 'en';
const { entry, next } = Astro.props;
// description — начало текста самого кейса (уникален у каждого, ≤155 символов); JSON-LD — CreativeWork.
const description = caseDescription(entry);
const jsonLd = caseJsonLd(entry, new URL(Astro.url.pathname, Astro.site!), Astro.site!);
---

<Base
  title={`${entry.data.title} — ${entry.data.client} · Maria Tkachenko`}
  description={description}
  lang={lang}
  ogType="article"
  jsonLd={jsonLd}
>
  <Nav lang={lang} />
  <CaseArticle entry={entry} lang={lang} next={next} />
  <Footer lang={lang} />
</Base>
