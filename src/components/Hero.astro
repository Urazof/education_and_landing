---
// Hero + About merged (по макету Miro): текст+фото, затем bridge к Works.
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '../i18n/ui';
import mariaPhoto from '../assets/maria-photo.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="py-10 sm:py-14">
  <!-- Две колонки: текст слева, фото справа -->
  <div class="grid items-start gap-10 sm:grid-cols-[minmax(0,1fr)_auto]">
    <div class="max-w-xl">
      <h1 class="text-2xl font-bold leading-tight sm:text-3xl">{t('hero.greeting')}</h1>
      <p class="mt-4 text-base leading-relaxed opacity-80">{t('hero.intro')}</p>
      <p class="mt-4 text-base leading-relaxed">{t('about.p1')}</p>
    </div>
    <div class="flex-shrink-0">
      <Image
        src={mariaPhoto}
        alt={t('hero.photoAlt')}
        class="w-36 rounded-[5px] sm:w-44"
        loading="eager"
      />
    </div>
  </div>

  <!-- Bridge-текст (y:224 в Miro, между hero и Works) -->
  <p class="mx-auto mt-10 max-w-2xl text-center text-base font-semibold sm:text-lg">{t('bridge')}</p>
</section>
